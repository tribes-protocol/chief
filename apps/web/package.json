{
  "name": "@chief/web",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3000",
    "build": "next build",
    "build:ci": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint . package.json --ext .ts,.tsx --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . package.json --ext .ts,.tsx --fix --max-warnings 0 --no-warn-ignored",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "chief": {
    "privateWebDeferredConsumerContracts": {
      "sse": {
        "app-shell": {
          "entry": "src/providers/CompanyEventsProvider.tsx",
          "export": "CompanyEventsProvider"
        },
        "S5-lifecycle": {
          "entry": "src/services/SseClientService.ts",
          "export": "streamLifecycle"
        },
        "S6-person": {
          "entry": "src/hooks/UsePersonStream.ts",
          "export": "usePersonStream"
        },
        "S7-company": {
          "entry": "src/hooks/UseCompanyEvents.ts",
          "export": "useCompanyEvents"
        }
      }
    }
  },
  "dependencies": {
    "@chief/chiefing": "workspace:*",
    "@chief/piing": "workspace:*",
    "next": "15.5.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jasmine": "4.2.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typebox": "1.3.18",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
